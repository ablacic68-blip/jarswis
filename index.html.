<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JARVIS AI</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: #0b0f19;
      color: #e2e8f0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      height: 100vh;
      padding: 30px 20px;
    }
    header { text-align: center; }
    h1 { color: #38bdf8; font-size: 28px; letter-spacing: 2px; }
    
    .content {
      width: 100%;
      max-width: 500px;
      text-align: center;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    #status { color: #94a3b8; font-size: 16px; margin-bottom: 20px; }
    #response {
      background: #1e293b;
      padding: 20px;
      border-radius: 12px;
      border: 1px solid #334155;
      font-size: 18px;
      line-height: 1.5;
      max-height: 250px;
      overflow-y: auto;
      text-align: left;
    }

    .controls { display: flex; flex-direction: column; align-items: center; }
    .mic-btn {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: linear-gradient(135deg, #0284c7, #2563eb);
      border: none;
      color: white;
      font-size: 36px;
      cursor: pointer;
      box-shadow: 0 0 25px rgba(2, 132, 199, 0.5);
      transition: transform 0.2s;
    }
    .mic-btn:active { transform: scale(0.95); }
    .listening { animation: pulse 1.5s infinite; background: #ef4444; box-shadow: 0 0 25px rgba(239, 68, 68, 0.6); }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.08); }
      100% { transform: scale(1); }
    }
  </style>
</head>
<body>

  <header>
    <h1>J.A.R.V.I.S.</h1>
  </header>

  <div class="content">
    <div id="status">Pritisnite mikrofon i recite nešto...</div>
    <div id="response">Spreman za rad.</div>
  </div>

  <div class="controls">
    <button id="micBtn" class="mic-btn" onclick="toggleListening()">🎙️</button>
  </div>

  <script>
   )https://jarswis.onrender.com/
    const BACKEND_URL = "https://tvoj-jarvis-backend.onrender.com/api/jarvis";

    let recognition;
    let isListening = false;

    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      recognition = new SpeechRecognition();
      recognition.lang = 'hr-HR';
      recognition.continuous = false;

      recognition.onstart = () => {
        isListening = true;
        document.getElementById('micBtn').classList.add('listening');
        document.getElementById('status').innerText = "Slušam vas...";
      };

      recognition.onend = () => {
        isListening = false;
        document.getElementById('micBtn').classList.remove('listening');
      };

      recognition.onresult = async (event) => {
        const text = event.results[0][0].transcript;
        document.getElementById('status').innerText = `Čuo sam: "${text}"`;
        document.getElementById('response').innerText = "JARVIS razmišlja...";

        try {
          const res = await fetch(BACKEND_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: text })
          });
          
          const data = await res.json();
          document.getElementById('response').innerText = data.reply;
          document.getElementById('status').innerText = `Model: ${data.model_used || 'Spreman'}`;

          speakResponse(data.reply);
        } catch (err) {
          document.getElementById('response').innerText = "Pogreška pri spajanju na server.";
          document.getElementById('status').innerText = "Pritisnite mikrofon za ponovni pokušaj.";
        }
      };
    } else {
      alert("Vaš preglednik ne podržava glasovni unos.");
    }

    function toggleListening() {
      if (isListening) {
        recognition.stop();
      } else {
        recognition.start();
      }
    }

    function speakResponse(text) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'hr-HR';
        utterance.rate = 1.0;
        window.speechSynthesis.speak(utterance);
      }
    }
  </script>
</body>
</html>
